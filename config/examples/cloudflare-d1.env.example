# Sample environment variables for an operator-owned, PRIVATE D1 sync.
# Never commit actual values; use your VPS secret manager in production.
CLOUDFLARE_ACCOUNT_ID=replace-with-your-account-id
CLOUDFLARE_D1_DATABASE_ID=replace-with-your-database-uuid
CLOUDFLARE_API_TOKEN=replace-with-a-restricted-d1-api-token
